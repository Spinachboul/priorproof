AI_PROVIDER=mock
DEMO_ACCESS_KEY=replace-with-a-long-random-local-key
# Enable the public user1 / abc123 login only when using fictional demo storage.
DEMO_LOGIN_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=60
DATABASE_PATH=./data/priorproof.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
# Add exact frontend origins for an opt-in LAN demo, e.g. http://192.168.1.20:3000
CORS_ORIGINS=
